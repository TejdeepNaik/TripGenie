# TripGenie Root Environment Variables Example Template
# Copy to .env for local development override or configure in deployment platform

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripgenie?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tripgenie
POSTGRES_PORT=5432

# Fastify API Server Settings
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=tripgenie_super_secret_session_key_min_32_bytes_long_dev
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Feature Flags & Providers
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
