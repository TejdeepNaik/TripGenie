# Fastify API Environment Configuration Template

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripgenie?schema=public"

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=tripgenie_super_secret_session_key_min_32_bytes_long_dev
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Feature Integration Flags
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
